{
  "exclude": ["cli/", "lib/", "src/service-worker.ts"],
  "include": ["src"],
  "references": [{ "path": "./tsconfig.service-worker.json" }],
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "paths": {
      "@/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true

    /* Enable when incremental compilation is introduced. */
    // "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    /* Enable after converting type-only imports to `import type`. */
    // "verbatimModuleSyntax": true,

    /* Enable after cleaning up unused locals; currently also enforced by ESLint. */
    // "noUnusedLocals": true,

    /* Enable after aligning the unused-parameter policy with ESLint. */
    // "noUnusedParameters": true,

    /* Enable after replacing TypeScript syntax that requires runtime transformation. */
    // "erasableSyntaxOnly": true
  }
}
